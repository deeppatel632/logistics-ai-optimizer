      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_requests_total{status=~\"5..\",job=\"fastapi\"}[5m])) / sum(rate(http_requests_total{job=\"fastapi\"}[5m]))",
