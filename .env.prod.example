# =============================================================================
# Production environment template
# cp .env.prod.example .env.prod  →  then fill in the values marked CHANGE
# .env.prod is git-ignored and must never be committed.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Database  ⚠  CHANGE DB_PASSWORD and rebuild the PRIMARY/REPLICA URLs
# ---------------------------------------------------------------------------
DB_USER=sa
DB_PASSWORD=CHANGE_THIS_Strong!Passw0rd
DB_SERVER=sql_edge
DB_PORT=1433
DB_NAME=logistics_db
DB_DRIVER=ODBC Driver 18 for SQL Server

# These URLs must match DB_USER / DB_PASSWORD / DB_SERVER / DB_NAME above.
PRIMARY_DB_URL=mssql+pyodbc://sa:CHANGE_THIS_Strong!Passw0rd@sql_edge:1433/logistics_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
REPLICA_DB_URL=mssql+pyodbc://sa:CHANGE_THIS_Strong!Passw0rd@sql_edge:1433/logistics_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ---------------------------------------------------------------------------
# Connection pool (tune to your host resources)
# ---------------------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Redis (container service name used as hostname inside the Docker network)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# JWT  ⚠  CHANGE JWT_SECRET to a long random string (e.g. `openssl rand -hex 32`)
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ---------------------------------------------------------------------------
# Celery workers
# Computed from the REDIS_* fields above — no extra config required.
# To point workers at a different Redis instance, set these explicitly:
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Grafana  (GRAFANA_ADMIN_PASSWORD falls back to "admin" if omitted)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_admin_password
